{
  "version": 2,
  "builds": [
    {
      "src": "api/test.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/search.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/show.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/test",
      "dest": "/api/test"
    },
    {
      "src": "/api/search",
      "dest": "/api/search"
    },
    {
      "src": "/api/show",
      "dest": "/api/show"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
