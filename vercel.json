{
  "version": 2,
  "functions": {
    "api/search.js": {
      "maxDuration": 10
    },
    "api/show.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/search",
      "dest": "/api/search"
    },
    {
      "src": "/api/show",
      "dest": "/api/show"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
